# GitHub OAuth App credentials
# Create one at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_OAUTH_SCOPES="repo read:org read:user"

# Frontend app origin (used for OAuth popup postMessage target)
# Dev example:  http://localhost:3000
# Prod example: https://codecollab.noharafamily.xyz
FRONTEND_URL=http://localhost:3000

# Optional comma-separated CORS origins. If omitted, FRONTEND_URL is used.
# FRONTEND_ORIGINS=http://localhost:3000,https://codecollab.noharafamily.xyz

# Public backend URL used for GitHub OAuth redirect_uri.
# Leave empty in local dev (callback stays on FRONTEND_URL + /api through dev proxy).
# Set in production, e.g. https://api.codecollab.noharafamily.xyz
BACKEND_PUBLIC_URL=

# OnlineCompiler.io Code Execution API (Recommended)
# Get a free key at: https://api.onlinecompiler.io
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key_here

# Judge0 Code Execution API (Alternative)
# Option 1: Use free Judge0 CE (Community Edition) - no API key needed
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# Option 2: Use RapidAPI (requires API key, get one at: https://rapidapi.com/judge0-official/api/judge0-ce)
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Option 3: Self-hosted Judge0 instance
# JUDGE0_API_URL=http://localhost:2358


# Gemma Code Mentor: server-side Gemini API key; never use a VITE_ key.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# OpenRouter key stays on the backend; local Ollama endpoint is configured above.
OPENROUTER_API_KEY=
GEMMA_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# Optional exact installed model tag; blank selects an installed Gemma 4.
GEMMA_LOCAL_MODEL=
