    "test:workspaces": "node --test tests/workspaces.test.mjs",
    "test:workspace-browser": "node tests/workspace-browser.mjs",
    "test:gemma-browser": "node tests/gemma-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
