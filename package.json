{
  "name": "skippy-collaborative-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --preview",
    "build": "npm --prefix skippy_paradox/frontend run build",
    "typecheck": "npm --prefix skippy_paradox/frontend run typecheck",
    "test:collab": "node --test tests/collab.test.mjs",
