# Copy to .env in this directory. Restart npm run dev after editing.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:2b
# Required for the harness when a collaborator accesses the IDE over the network.
SKIPPY_ACCESS_TOKEN=
# Optional. Every shell command still requires approval in the harness panel.
# Shell commands run with the server user's permissions, not in a container.
SKIPPY_ALLOW_SHELL=false
MAX_AGENT_STEPS=20
LLM_TIMEOUT=300

# Gemma Code Mentor: server-side Gemini API key; never use a VITE_ key.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# OpenRouter key stays on the backend; local Ollama endpoint is configured above.
OPENROUTER_API_KEY=
GEMMA_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# Optional exact installed model tag; blank selects an installed Gemma 4.
GEMMA_LOCAL_MODEL=
